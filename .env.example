# ==========================================================
# SABYR — Пример переменных окружения
# Скопируйте этот файл в .env.local и заполните значения
# На Vercel добавьте эти же переменные через:
# Settings -> Environment Variables
# ==========================================================

# ----------------------------------------------------------
# 1. БАЗА ДАННЫХ (Neon PostgreSQL)
# Получить: https://console.neon.tech
# Connection Details -> Connection string (Pooled + Direct)
# ----------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------
# 2. JWT / СЕССИИ
# Сгенерировать секрет: https://generate-secret.vercel.app/32
# На Vercel NEXTAUTH_URL = ваш домен (https://sabyr.vercel.app)
# ----------------------------------------------------------
JWT_SECRET="замените-на-случайную-строку-минимум-32-символа"
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="замените-на-случайную-строку"

# ----------------------------------------------------------
# 3. GOOGLE GEMINI AI (ИИ-стилист и ИИ-примерочная)
# Получить: https://aistudio.google.com/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"

# ----------------------------------------------------------
# 4. KASPI PAY (оплата через Kaspi QR)
# Получить: https://kaspi.kz/biz -> Магазин -> Интеграция
# ----------------------------------------------------------
KASPI_PAY_API_KEY=""
KASPI_PAY_MERCHANT_ID=""

# ----------------------------------------------------------
# 5. CLOUDPAYMENTS KZ (оплата картой)
# Получить: https://cloudpayments.kz -> Личный кабинет
# ----------------------------------------------------------
CLOUDPAYMENTS_PUBLIC_ID=""
CLOUDPAYMENTS_API_SECRET=""

# ----------------------------------------------------------
# 6. SMS (Mobizon KZ) — отправка OTP кодов
# Получить: https://mobizon.kz -> API -> Ключи
# Если пусто — демо-режим (код виден на экране)
# ----------------------------------------------------------
SMS_API_KEY=""
SMS_SENDER_NAME="SABYR"

# ----------------------------------------------------------
# 7. EMAIL (Resend) — отправка кодов и чеков на почту
# Получить: https://resend.com/api-keys
# EMAIL_FROM: сначала используйте onboarding@resend.dev
# Для своего домена верифицируйте его на resend.com/domains
# ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="SABYR <onboarding@resend.dev>"

# ----------------------------------------------------------
# 8. ПУБЛИЧНЫЕ НАСТРОЙКИ САЙТА
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_NAME="SABYR"
