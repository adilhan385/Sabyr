// This is your Prisma schema file for SABYR Luxury Fashion
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS & AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  name          String?
  avatar        String?
  role          Role      @default(CUSTOMER)
  isBlocked     Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations (optional if using NextAuth)
  accounts Account[]
  sessions Session[]

  // Shopping & Preferences
  orders               Order[]
  addresses            Address[]
  favorites            Favorite[]
  cart                 CartItem[]
  restockNotifications RestockNotification[]
  tryOnSessions        TryOnSession[]

  // Bonuses & SABYR Club
  bonusBalance   Int                @default(0) // In bonus points
  bonusLevelId   String?
  bonusLevel     BonusLevel?        @relation(fields: [bonusLevelId], references: [id])
  bonusHistory   BonusTransaction[]
  clubMembership ClubMembership?

  // Gift cards & Promos
  giftCards   GiftCard[]       @relation("GiftCardOwner")
  promoUsages PromoCodeUsage[]

  // Notifications
  notifications Notification[]

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// SMS OTP Verification table for Kazakhstan (+7)
model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, isUsed, expiresAt])
  @@map("otp_verifications")
}

// ==================== CATALOG & PRODUCTS ====================

model Category {
  id          String      @id @default(cuid())
  name        String
  nameRu      String?
  slug        String      @unique
  description String?
  image       String?
  order       Int         @default(0)
  isActive    Boolean     @default(true)
  parentId    String?
  parent      Category?   @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]  @relation("SubCategories")
  products    Product[]
  sizeGuides  SizeGuide[]
  createdAt   DateTime    @default(now())

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  composition String?
  care        String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  // Pricing in minor currency units (tiyn: 1 KZT = 100 tiyn, e.g. 89000 KZT = 8900000)
  price        Int
  comparePrice Int? // Original price in tiyn (for sale items)

  // Status flags
  isActive     Boolean @default(true)
  isNew        Boolean @default(false)
  isBestSeller Boolean @default(false)
  isClubOnly   Boolean @default(false) // Only for SABYR CLUB members

  // AI & Recommendation Context
  aiDescription String?  @db.Text
  occasionTags  String[]
  styleTags     String[]

  // Relations
  images               ProductImage[]
  variants             ProductVariant[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  favorites            Favorite[]
  restockNotifications RestockNotification[]
  tryOnSessions        TryOnSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive, price])
  @@index([isClubOnly])
  @@index([isNew])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isVideo   Boolean @default(false)
  order     Int     @default(0)

  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  colorHex  String?
  size      String
  stock     Int     @default(0)
  sku       String? @unique

  cartItems            CartItem[]
  orderItems           OrderItem[]
  restockNotifications RestockNotification[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

// Size guide table for categories & products
model SizeGuide {
  id         String    @id @default(cuid())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  size       String // "XS", "S", "M", "L", "XL"
  ruSize     String // "42", "44", "46", "48", "50"
  bust       String // "82-86"
  waist      String // "62-66"
  hips       String // "90-94"
  length     String? // "115"
  createdAt  DateTime  @default(now())

  @@map("size_guides")
}

// Restock notification / Waitlist when variant is out of stock
model RestockNotification {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  email      String?
  phone      String?
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     RestockStatus   @default(PENDING)
  createdAt  DateTime        @default(now())
  notifiedAt DateTime?

  @@map("restock_notifications")
}

enum RestockStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

// ==================== CART ====================

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@map("cart_items")
}

// ==================== ORDERS & PAYMENTS ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  // Pricing in tiyn (minor units)
  subtotal       Int
  discount       Int          @default(0)
  bonusUsed      Int          @default(0) // 1 bonus = 1 KZT = 100 tiyn
  deliveryCost   Int          @default(0)
  total          Int
  giftCardId     String?
  giftCard       GiftCard?    @relation(fields: [giftCardId], references: [id])
  giftCardAmount Int          @default(0) // in tiyn
  promoCodeId    String?
  promoCode      PromoCode?   @relation(fields: [promoCodeId], references: [id])

  // Delivery
  deliveryType DeliveryType @default(COURIER)
  addressId    String?
  address      Address?     @relation(fields: [addressId], references: [id])

  // Payment
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?

  // Tracking
  trackingNumber String?
  notes          String?

  items        OrderItem[]
  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryType {
  COURIER
  PICKUP
  POSTAL
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int // in tiyn
  color     String
  size      String

  @@map("order_items")
}

model PaymentTransaction {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway        PaymentGateway
  paymentId      String? // External transaction ID from Kaspi/CloudPayments
  amount         Int // In tiyn
  status         PaymentStatus  @default(PENDING)
  idempotencyKey String?        @unique
  rawPayload     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("payment_transactions")
}

enum PaymentGateway {
  KASPI_QR
  CARD_CLOUDPAYMENTS
  FREEDOM_PAY
  CASH_ON_DELIVERY
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String? // "Дом", "Офис"
  city       String
  street     String
  apartment  String?
  postalCode String?
  isDefault  Boolean @default(false)

  orders Order[]

  @@map("addresses")
}

// ==================== FAVORITES ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

// ==================== BONUS & LOYALTY ====================

model BonusLevel {
  id                String  @id @default(cuid())
  name              String // "Level 1 — Starter", "Level 4 — Platinum VIP"
  minPurchaseAmount Int // Minimum total spend in tiyn to reach this level
  bonusPercent      Float // % of order credited as bonuses (e.g. 5.0)
  privileges        Json?
  color             String?
  order             Int     @default(0)

  users User[]

  @@map("bonus_levels")
}

model BonusTransaction {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        BonusTransactionType
  amount      Int // Positive = earned, negative = spent
  description String
  orderId     String?
  createdAt   DateTime             @default(now())

  @@map("bonus_transactions")
}

enum BonusTransactionType {
  EARNED
  SPENT
  EXPIRED
  MANUAL_ADD
  MANUAL_DEDUCT
}

// ==================== SABYR CLUB ====================

model ClubMembership {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  plan      ClubPlan  @default(MONTHLY)

  @@map("club_memberships")
}

enum ClubPlan {
  MONTHLY
  ANNUAL
}

model ClubSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("club_settings")
}

// ==================== GIFT CARDS & PROMOS ====================

model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Int // Original amount in tiyn
  balance   Int // Remaining balance in tiyn
  ownerId   String?
  owner     User?     @relation("GiftCardOwner", fields: [ownerId], references: [id])
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now())

  @@map("gift_cards")
}

model PromoCode {
  id             String        @id @default(cuid())
  code           String        @unique
  type           PromoCodeType
  value          Int // If PERCENTAGE: percent value (e.g. 15). If FIXED: amount in tiyn
  maxUses        Int?
  usedCount      Int           @default(0)
  minOrderAmount Int? // In tiyn
  expiresAt      DateTime?
  isActive       Boolean       @default(true)

  categoryIds  String[]
  productIds   String[]
  userSpecific Boolean  @default(false)

  usages          Order[]
  promoCodeUsages PromoCodeUsage[]

  createdAt DateTime @default(now())

  @@map("promo_codes")
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String?
  usedAt      DateTime  @default(now())

  @@map("promo_code_usages")
}

// ==================== AI TRY-ON SESSIONS ====================

model TryOnSession {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userPhotoUrl String
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  resultUrl    String?
  status       TryOnStatus @default(PENDING)
  errorMessage String?
  consentGiven Boolean     @default(true)
  expiresAt    DateTime // Biometric privacy cleanup after 24 hours
  createdAt    DateTime    @default(now())

  @@map("tryon_sessions")
}

enum TryOnStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==================== NOTIFICATIONS & CMS ====================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  ORDER_STATUS
  BONUS_EARNED
  NEW_DROP
  BACK_IN_STOCK
  PERSONAL_OFFER
  CLUB_OFFER
}

model Banner {
  id       String   @id @default(cuid())
  title    String?
  subtitle String?
  imageUrl String
  videoUrl String?
  link     String?
  isActive Boolean  @default(true)
  order    Int      @default(0)

  createdAt DateTime @default(now())

  @@map("banners")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  createdAt DateTime @default(now())

  @@map("collections")
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

