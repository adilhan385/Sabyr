// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS ====================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  name          String?
  avatar        String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth
  accounts Account[]
  sessions Session[]

  // Shopping
  orders          Order[]
  addresses       Address[]
  favorites       Favorite[]
  cart            CartItem[]

  // Bonuses & Club
  bonusBalance    Int              @default(0)
  bonusLevelId    String?
  bonusLevel      BonusLevel?      @relation(fields: [bonusLevelId], references: [id])
  bonusHistory    BonusTransaction[]
  clubMembership  ClubMembership?

  // Gift cards & Promos
  giftCards       GiftCard[]       @relation("GiftCardOwner")
  promoUsages     PromoCodeUsage[]

  // Notifications
  notifications   Notification[]

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== PRODUCTS ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  nameRu      String?
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    String?
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  composition String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  // Pricing
  price       Float
  comparePrice Float? // Original price (for sale items)

  // Status
  isActive    Boolean  @default(true)
  isNew       Boolean  @default(false)
  isBestSeller Boolean @default(false)
  isClubOnly  Boolean  @default(false) // Only for SABYR CLUB members

  // AI
  aiDescription String? @db.Text // For AI Stylist context

  // Relations
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  favorites   Favorite[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isVideo   Boolean @default(false)
  order     Int     @default(0)

  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  colorHex  String?
  size      String
  stock     Int     @default(0)
  sku       String? @unique

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

// ==================== CART ====================

model CartItem {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@map("cart_items")
}

// ==================== ORDERS ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  // Pricing
  subtotal    Float
  discount    Float       @default(0)
  bonusUsed   Int         @default(0)
  deliveryCost Float      @default(0)
  total       Float

  // Promo / Gift
  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  giftCardId  String?
  giftCard    GiftCard?  @relation(fields: [giftCardId], references: [id])
  giftCardAmount Float   @default(0)

  // Delivery
  deliveryType DeliveryType @default(COURIER)
  addressId   String?
  address     Address?   @relation(fields: [addressId], references: [id])

  // Payment
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?

  // Tracking
  trackingNumber String?
  notes          String?

  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryType {
  COURIER
  PICKUP
  POSTAL
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float
  color     String
  size      String

  @@map("order_items")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String? // "Дом", "Работа"
  city       String
  street     String
  apartment  String?
  postalCode String?
  isDefault  Boolean @default(false)

  orders Order[]

  @@map("addresses")
}

// ==================== FAVORITES ====================

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

// ==================== BONUS SYSTEM ====================

model BonusLevel {
  id              String   @id @default(cuid())
  name            String   // "Level 1", "Level 2", etc.
  minPurchaseAmount Float  // Minimum total purchases to reach this level
  bonusPercent    Float    // % of order converted to bonuses
  privileges      Json?    // Flexible privileges stored as JSON
  color           String?  // UI color for the level badge
  order           Int      @default(0)

  users User[]

  @@map("bonus_levels")
}

model BonusTransaction {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        BonusTransactionType
  amount      Int                 // Positive = earned, negative = spent
  description String
  orderId     String?

  createdAt   DateTime            @default(now())

  @@map("bonus_transactions")
}

enum BonusTransactionType {
  EARNED
  SPENT
  EXPIRED
  MANUAL_ADD
  MANUAL_DEDUCT
}

// ==================== SABYR CLUB ====================

model ClubMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @default(now())
  endDate   DateTime?
  isActive  Boolean  @default(true)
  plan      ClubPlan @default(MONTHLY)

  @@map("club_memberships")
}

enum ClubPlan {
  MONTHLY
  ANNUAL
}

model ClubSettings {
  id         String @id @default(cuid())
  key        String @unique
  value      String @db.Text
  updatedAt  DateTime @updatedAt

  @@map("club_settings")
}

// ==================== GIFT CARDS ====================

model GiftCard {
  id          String   @id @default(cuid())
  code        String   @unique
  amount      Float    // Original amount
  balance     Float    // Remaining balance
  ownerId     String?
  owner       User?    @relation("GiftCardOwner", fields: [ownerId], references: [id])
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())

  @@map("gift_cards")
}

// ==================== PROMO CODES ====================

model PromoCode {
  id              String        @id @default(cuid())
  code            String        @unique
  type            PromoCodeType
  value           Float         // % or fixed amount
  maxUses         Int?          // null = unlimited
  usedCount       Int           @default(0)
  minOrderAmount  Float?
  expiresAt       DateTime?
  isActive        Boolean       @default(true)

  // Restrictions
  categoryIds     String[]      // Empty = all categories
  productIds      String[]      // Empty = all products
  userSpecific    Boolean       @default(false) // For influencer codes

  usages Order[]
  promoCodeUsages PromoCodeUsage[]

  createdAt DateTime @default(now())

  @@map("promo_codes")
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String?
  usedAt      DateTime  @default(now())

  @@map("promo_code_usages")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json?            // Extra data (orderId, productId, etc.)

  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  ORDER_STATUS
  BONUS_EARNED
  NEW_DROP
  BACK_IN_STOCK
  PERSONAL_OFFER
  CLUB_OFFER
}

// ==================== CONTENT (Admin) ====================

model Banner {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  videoUrl  String?
  link      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)

  createdAt DateTime @default(now())

  @@map("banners")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())

  @@map("collections")
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}
